#. STRINGS.SKIN_DESCRIPTIONS.researchlab4_festive_bell_red_firehound
msgctxt "STRINGS.SKIN_DESCRIPTIONS.researchlab4_festive_bell_red_firehound"
msgid "researchlab4_festive_bell_red_firehound"
msgstr "researchlab4_festive_bell_red_firehound"

