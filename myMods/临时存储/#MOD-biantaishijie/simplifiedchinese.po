#. STRINGS.STALKER_ATRIUM_BATTLECRY.1
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.1"
msgid "A pity."
msgstr "真可悲。"

#. STRINGS.STALKER_ATRIUM_BATTLECRY.2
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.2"
msgid "You will not suffer."
msgstr "你会痛快地死去的。"

#. STRINGS.STALKER_ATRIUM_BATTLECRY.3
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.3"
msgid "It must be this way."
msgstr "这是唯一的办法。"

#. STRINGS.STALKER_ATRIUM_BATTLECRY.4
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.4"
msgid "My world... threadbare."
msgstr "我的世界……残破不堪。"

#. STRINGS.STALKER_ATRIUM_BATTLECRY.5
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.5"
msgid "My city... in tatters..."
msgstr "我的城市……一片废墟……"

#. STRINGS.STALKER_ATRIUM_BATTLECRY.6
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.6"
msgid "This will be quick."
msgstr "就让你死得痛快。"

#. STRINGS.STALKER_ATRIUM_BATTLECRY.7
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.7"
msgid "How we've fallen."
msgstr "我们竟然堕落至此。"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.1
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.1"
msgid "Fools!"
msgstr "蠢蛋！"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.2
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.2"
msgid "Who are you?"
msgstr "你是谁？"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.3
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.3"
msgid "Release me, shade!"
msgstr "放开我，阴影！"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.4
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.4"
msgid "You are not Them..."
msgstr "你不是他们的一份子……"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.5
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.5"
msgid "Are you so easily deceived? Ha..."
msgstr "你就这么容易上当了？哈哈……"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.6
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.6"
msgid "You deserve this."
msgstr "你活该的。"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.7
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.7"
msgid "You've made your choice."
msgstr "这是你自找的。"

#. STRINGS.STALKER_ATRIUM_DECAYCRY.1
msgctxt "STRINGS.STALKER_ATRIUM_DECAYCRY.1"
msgid "Please..."
msgstr "拜托……"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.1
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.1"
msgid "You will fall as we did."
msgstr "你会跟我们一样倒下的。"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.2
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.2"
msgid "This is for the best."
msgstr "牺牲小你，成全大我吧。"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.3
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.3"
msgid "You will be unraveled."
msgstr "你会被彻底击溃。"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.4
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.4"
msgid "They are coming. It cannot be stopped."
msgstr "他们来了。阻挡不了他们的。"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.5
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.5"
msgid "This world's fabric is frayed and torn."
msgstr "这个世界的织物已经磨损撕裂了。"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.6
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.6"
msgid "They are unfathomable."
msgstr "他们是深不可测的。"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.7
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.7"
msgid "I will save you."
msgstr "我会解救你的。"

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.1
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.1"
msgid "I will stop this."
msgstr "我会阻止这一切。"

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.2
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.2"
msgid "You cannot win."
msgstr "你赢不了的。"

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.3
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.3"
msgid "Lend me your power, one last time."
msgstr "把你的力量再借给我最后一遍吧。"

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.4
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.4"
msgid "You cannot hurt me."
msgstr "你伤害不了我的。"

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.5
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.5"
msgid "Protect me."
msgstr "保护我。"

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.6
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.6"
msgid "You have been betrayed."
msgstr "你被背叛了。"

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.7
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.7"
msgid "I must do this. For your sake."
msgstr "我必须这么做。这是为你好。"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.1
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.1"
msgid "Be woven."
msgstr "准备好被编织吧。"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.2
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.2"
msgid "How long have I slumbered?"
msgstr "我沉睡了多长时间？"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.3
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.3"
msgid "Let the fuel take shape."
msgstr "让燃料显形吧。"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.4
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.4"
msgid "I will not be defeated so easily."
msgstr "我不会这么容易被击败的。"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.5
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.5"
msgid "I will make you understand."
msgstr "我会让你明白的。"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.6
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.6"
msgid "Let us end it."
msgstr "我们来终结这一切吧。"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.7
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.7"
msgid "You will rip apart at the seams."
msgstr "你会在线缝中被撕碎。"

#. STRINGS.STALKER_ATRIUM_USEGATE.1
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.1"
msgid "I will save us."
msgstr "我会拯救大家的。"

#. STRINGS.STALKER_ATRIUM_USEGATE.2
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.2"
msgid "Curse Their name!"
msgstr "诅咒那些天杀的名字！"

#. STRINGS.STALKER_ATRIUM_USEGATE.3
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.3"
msgid "It cannot end like this."
msgstr "绝不能就这样结束。"

#. STRINGS.STALKER_ATRIUM_USEGATE.4
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.4"
msgid "I was wrong."
msgstr "我曾经错过。"

#. STRINGS.STALKER_ATRIUM_USEGATE.5
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.5"
msgid "Return them to me!"
msgstr "把他们还给我！"

#. STRINGS.STALKER_ATRIUM_USEGATE.6
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.6"
msgid "Why?"
msgstr "为什么？"

#. STRINGS.STALKER_ATRIUM_USEGATE.7
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.7"
msgid "Metheus..."
msgstr "米修斯……"

#. STRINGS.STALKER_BATTLECRY.1
msgctxt "STRINGS.STALKER_BATTLECRY.1"
msgid "Huurgh..."
msgstr "哈……"

#. STRINGS.STALKER_BATTLECRY.2
msgctxt "STRINGS.STALKER_BATTLECRY.2"
