msgstr "它是……活的？！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CHESSPIECE_MOOSEGOOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CHESSPIECE_MOOSEGOOSE"
